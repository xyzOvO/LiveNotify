<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部：状态点 + 状态文字 + 计数胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_header_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="●"
            android:textSize="10sp"
            android:textColor="#F2EFF7"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_header_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F2EFF7"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="监控正常" />

        <TextView
            android:id="@+id/widget_header_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_count_pill"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:text="" />
    </LinearLayout>

    <!-- 滚动列表：RemoteViews 集合，条目由 WidgetListService.Factory 提供 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:listSelector="@android:color/transparent" />

    <!-- 空态：官方文档要求空 View 是集合 View 的兄弟节点，不能塞进 ListView -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#A9A3B8"
        android:text="@string/widget_empty"
        android:visibility="gone" />
</LinearLayout>
