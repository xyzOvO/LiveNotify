<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部：醒目的在播计数胶囊 + 状态文字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_header_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F2EFF7"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="监控正常" />

        <TextView
            android:id="@+id/widget_header_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_count_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#A9A3B8"
        android:text="@string/widget_empty"
        android:visibility="gone" />

    <!-- 条目 1 -->
    <LinearLayout
        android:id="@+id/widget_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/widget_item1_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_avatar_bg"
                android:scaleType="centerCrop"
                android:contentDescription="@string/widget_description" />

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/widget_live_dot"
                android:contentDescription="@string/widget_description" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:id="@+id/widget_item1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2EFF7"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/widget_item1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#A9A3B8"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_item1_platform"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_description" />
    </LinearLayout>

    <!-- 条目 2 -->
    <LinearLayout
        android:id="@+id/widget_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/widget_item2_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_avatar_bg"
                android:scaleType="centerCrop"
                android:contentDescription="@string/widget_description" />

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/widget_live_dot"
                android:contentDescription="@string/widget_description" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:id="@+id/widget_item2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2EFF7"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/widget_item2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#A9A3B8"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_item2_platform"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_description" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textSize="11sp"
        android:textColor="#A9A3B8"
        android:maxLines="1"
        android:text=""
        android:visibility="gone" />
</LinearLayout>
