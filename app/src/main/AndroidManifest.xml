<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ 通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      前台服务：1~3 分钟轮询必须常驻，Android 14 起必须声明具体类型。
      用 specialUse 而不是 dataSync：Android 15 给 dataSync 加了「24 小时累计最多跑 6 小时」的硬限制，
      到点系统直接停服务且不提示，开播提醒会静默失效。specialUse 不受该限制。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 开机自启（可选，部分国产 ROM 需手动放行） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      引导用户关闭电池优化（仅在设置页点击时跳转到系统页，不默认申请）。
      lint 的 BatteryLife 针对 Google Play 上架政策；本项目只通过 GitHub Releases 分发，不适用。
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- 应用内更新：安装下载的 APK（Android 8+ 需用户先授权「允许来自此来源的应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Android 11+ 包可见性：不加这段，queryIntentActivities 只会返回空列表，
      安装器的 URI 读权限就授不出去，部分 ROM 上表现为「解析包失败」。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".LiveNotifyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveNotify"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LiveNotify"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse：见上方权限注释。subtype 是给系统与审核看的一句话用途说明 -->
        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续轮询已关注主播的开播状态，开播时发本地提醒" />
        </service>

        <!-- 应用内更新：把下载好的 APK 授权给系统安装器读取（Android 7+ 禁止 file:// 跨进程） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".monitor.BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 解锁广播作为第二道保险：部分 ROM 吞掉 BOOT_COMPLETED 但仍会发 USER_PRESENT -->
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
